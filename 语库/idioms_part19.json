    {
      "id": "jing_di_zhi_wa",
      "word": "井底之蛙",
      "pinyin": "jǐng dǐ zhī wā",
      "frequency": 4,
      "coreMeaning": "井底的青蛙只能看到井口那么大的天，比喻见识短浅、眼界狭隘的人。",
      "morphemeHint": {
        "keyChar": "蛙",
        "explanation": "名词性偏正成语，多充当宾语或主语（“如同井底之蛙”），不直接作谓语动词。"
      },
      "sentiment": "negative",
      "intensity": "medium",
      "applicableObjects": [
