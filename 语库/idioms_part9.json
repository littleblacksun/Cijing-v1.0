    {
      "id": "shi_zhi_bu_yu",
      "word": "矢志不渝",
      "pinyin": "shǐ zhì bù yú",
      "frequency": 4,
      "coreMeaning": "立下坚定志愿，永远不改变初衷和信念。",
      "morphemeHint": {
        "keyChar": "渝",
        "explanation": "“矢”意为发誓，“渝”意为改变；合指立志坚定、永不变节。"
      },
      "sentiment": "positive",
      "intensity": "heavy",
      "applicableObjects": [
        "理想信念",
        "奋斗者",
        "政党成员"
      ],
      "collocations": [
        "矢志不渝地坚守",
        "矢志不渝为人民服务"
      ],
      "commonMistake": "“矢”不是箭，作动词“发誓”讲；注意“渝”不要误写为“逾”。",
      "tags": [
        "国考高频",
        "易望文生义"
      ],
      "examples": [
        {
          "sentence": "一代代塞罕坝林场建设者____地守护绿色使命，将昔日荒原沙地变成了广袤林海。",
          "highlightClues": [
            "一代代",
            "守护绿色使命",
            "荒原沙地变成"
          ]
        }
      ],
      "confusableWith": [
        "坚定不移",
        "始终不渝",
        "半途而废"
      ]
    },
