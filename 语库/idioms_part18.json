    {
      "id": "cong_shan_ru_liu",
      "word": "从善如流",
      "pinyin": "cóng shàn rú liú",
      "frequency": 5,
      "coreMeaning": "形容听取正确意见就像水往低处流一样自然、痛快和迅速。",
      "morphemeHint": {
        "keyChar": "流",
        "explanation": "“善”指正确建议、好意见，“如流”指像流水般顺畅无阻，突出纳谏与纠错之快。"
      },
      "sentiment": "positive",
      "intensity": "medium",
      "applicableObjects": [
        "领导者",
        "决策者",
        "管理部门"
      ],
      "collocations": [
        "从善如流的胸襟",
        "面对批评从善如流"
      ],
      "commonMistake": "侧重“乐于接受正确意见”，常与“固执己见”“师心自用”形成反义；不能误用作“顺从潮流”或“做善事”。",
      "tags": [
        "国考高频",
        "省考高频",
        "易望文生义"
      ],
      "examples": [
        {
          "sentence": "面对网友指出的政务App界面繁琐问题，开发团队____，不到一周便上线了简洁清晰的适老化版本。",
          "highlightClues": [
            "网友指出的",
            "不到一周便上线"
          ]
        }
      ],
      "confusableWith": [
        "广开言路",
        "虚怀若谷",
        "顺理成章"
      ]
    },
    {
