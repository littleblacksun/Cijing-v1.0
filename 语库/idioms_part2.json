    {
      "id": "wang_qi_xiang_bei",
      "word": "望其项背",
      "pinyin": "wàng qí xiàng bèi",
      "frequency": 5,
      "coreMeaning": "能够望见别人的脖颈和后背，表示赶得上或相距不远，多用于否定句。",
      "morphemeHint": {
        "keyChar": "望",
        "explanation": "能望见对方的背影意味着差距不算太远；因此常用“难以望其项背”“不能望其项背”表远不如。"
      },
