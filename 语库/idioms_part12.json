    {
      "id": "seng_duo_zhou_shao",
      "word": "僧多粥少",
      "pinyin": "sēng duō zhōu shǎo",
      "frequency": 4,
      "coreMeaning": "和尚多而稀饭少，比喻需求的人或单位多而资源稀少，不够分配。",
      "morphemeHint": {
        "keyChar": "粥",
        "explanation": "直接点出“分配主体多、可分资源少”的供需失衡与分配矛盾。"
      },
      "sentiment": "neutral",
      "intensity": "medium",
      "applicableObjects": [
        "名额",
        "资金",
        "资源",
        "岗位"
      ],
      "collocations": [
        "面临僧多粥少的局面",
        "缓解僧多粥少"
      ],
      "commonMistake": "偏重“分配比例失衡导致竞争激烈或不够分”，若仅指市场商品脱销则宜用“供不应求”。",
      "tags": [
        "省考高频",
        "对象易错",
        "语义轻重"
      ],
      "examples": [
        {
          "sentence": "优质公立普惠托育学位长期处于____状态，客观上推高了年轻家庭的育儿成本，亟需加快扩容增量。",
