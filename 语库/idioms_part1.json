    {
      "id": "shou_dang_qi_chong",
      "word": "首当其冲",
      "pinyin": "shǒu dāng qí chōng",
      "frequency": 5,
      "coreMeaning": "比喻最先受到攻击、冲击或遭遇灾难，并非指冲在最前面。",
      "morphemeHint": {
        "keyChar": "冲",
        "explanation": "“当”是承受，“冲”指交通要道或攻击的锋芒；合起来指首先承受冲击，而非主动领先。"
      },
      "sentiment": "neutral",
      "intensity": "heavy",
      "applicableObjects": [
        "行业",
        "群体",
        "地区",
        "企业"
      ],
      "collocations": [
        "首当其冲受到影响",
        "首当其冲成为靶子"
      ],
      "commonMistake": "极易望文生义误用为“第一个冲上去”或“首要任务”，且多用于不利、受冲击的语境。",
      "tags": [
        "国考高频",
        "省考高频",
        "易望文生义"
      ],
      "examples": [
        {
          "sentence": "随着生成式人工智能在内容生产领域的普及，基础文案与翻译岗位____，面临着深刻的技能重构压力。",
          "highlightClues": [
            "普及",
            "面临着深刻的技能重构压力"
          ]
        }
      ],
      "confusableWith": [
        "首屈一指",
        "一马当先",
        "当务之急"
      ]
    },
    {
