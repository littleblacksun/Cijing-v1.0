    {
      "id": "yin_xiao_shi_da",
      "word": "因小失大",
      "pinyin": "yīn xiǎo shī dà",
      "frequency": 4,
      "coreMeaning": "为了贪图小的利益或计较小的得失，反而造成重大的损失。",
      "morphemeHint": {
        "keyChar": "小、大",
        "explanation": "“因小”指贪图小利或拘泥小节，“失大”指损失全局或长远利益。"
      },
      "sentiment": "negative",
      "intensity": "medium",
      "applicableObjects": [
        "商业决策",
        "生态保护",
        "项目规划",
        "人际合作"
      ],
      "collocations": [
        "切忌因小失大",
        "免得因小失大",
        "最终因小失大"
      ],
      "commonMistake": "与“得不偿失”区别：后者强调付出的代价大于得到的收获，前者强调为了眼前小利而丢掉更大利益。",
      "tags": [
        "国考高频",
        "省考高频",
        "易混淆"
      ],
      "examples": [
        {
          "sentence": "部分制造企业为压缩微薄的环保处理成本而偷排污水，一旦被查处不仅面临巨额罚款更毁掉品牌声誉，实属____。",
          "highlightClues": [
            "压缩微薄的环保处理成本",
            "巨额罚款更毁掉品牌声誉"
          ]
        }
      ],
      "confusableWith": [
        "得不偿失",
        "因噎废食",
        "舍本逐末"
      ]
    },
    {
